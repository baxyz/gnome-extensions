{
  "name": "@baxyz/browser-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Launch any browser profile from the GNOME indicator.",
  "homepage": "https://github.com/baxyz/gnome-extensions#readme",
  "bugs": {
    "url": "https://github.com/baxyz/gnome-extensions/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "baxyz <berenger@arnaud.work>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baxyz/gnome-extensions.git",
    "directory": "extensions/browser-hub"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "oxlint",
