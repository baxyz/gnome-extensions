    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "install:local": "../../tooling/scripts/install-local.sh",
    "pack": "../../tooling/scripts/pack.sh",
    "shexli": "../../tooling/scripts/shexli.sh"
  },
  "dependencies": {
    "@helpers4/object": "catalog:"
  },
  "devDependencies": {
    "@girs/gjs": "catalog:",
    "@girs/gnome-shell": "catalog:",
    "@girs/gnome-shell-46": "catalog:",
    "@girs/gnome-shell-47": "catalog:",
    "@girs/gnome-shell-48": "catalog:",
    "@girs/gnome-shell-49": "catalog:",
    "@girs/gnome-shell-50": "catalog:",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.20.0"
}
